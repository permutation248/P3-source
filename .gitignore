# Local / secrets
.env
# Claude Code-local settings: plain + temp/variant filenames like
# .claude/.efc_<pid>_<session>_..._settings.local.json. Cover any *.local.json
# under .claude/ so future Claude-generated variants don't leak either.
.claude/*.local.json
.claude/.*.local.json

# Runtime data
data/
results/
workspaces/active/

# Legacy experiment outputs (kept on disk, not in git)
Logs/
History/
Summary/
claude_traces/
/*_claude_output.json
*.log
backcopy/*
backup/
